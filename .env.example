# Copy to `.env` to override the compose defaults. Every value below is the
# same default the code and docker-compose.yml already apply, so `.env` is only
# needed when you want to change something.

# --- docker-compose: the Postgres service -------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todo-list_db

# --- API ----------------------------------------------------------------------
# Composed for you by docker-compose from POSTGRES_* above; set it directly when
# running the API outside compose (e.g. in the devcontainer).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo-list_db
PORT=8000
# Comma-separated origins, or `*` for any (the default). The web app is served
# same-origin behind nginx, so this only matters for a cross-origin client.
CORS_ORIGINS=*

# --- tests (optional) ---------------------------------------------------------
# Tests derive `todo-list_test` from DATABASE_URL when this is unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo-list_test
